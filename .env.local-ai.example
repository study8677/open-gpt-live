# Copy this file to .env before starting the local-ai Docker Compose profile.
# These are container-network URLs. No OpenAI or other cloud API key is needed.
OPEN_GPT_LIVE_ENV_FILE=.env
OPENAI_API_KEY=
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:1.5b

STT_API_KEY=
STT_BASE_URL=http://speaches:8000/v1
STT_MODEL=Systran/faster-whisper-small
STT_REALTIME_ENABLED=false

TTS_ENABLED=true
TTS_API_KEY=
TTS_BASE_URL=http://speaches:8000/v1
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=zf_xiaobei
TTS_FORMAT=mp3

GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8787

# Pinned provider images and the model pulled by the one-shot init service.
OLLAMA_IMAGE_TAG=0.30.8
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=15m
SPEACHES_IMAGE_TAG=0.8.3-cpu

# Host-side URLs used by `pnpm local-ai:check`.
LOCAL_AI_OLLAMA_PORT=11434
LOCAL_AI_SPEACHES_PORT=8000
LOCAL_AI_OLLAMA_URL=http://localhost:11434
LOCAL_AI_SPEACHES_URL=http://localhost:8000
