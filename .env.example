OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-1
STT_REALTIME_ENABLED=false
STT_REALTIME_URL=wss://api.openai.com/v1/realtime
STT_REALTIME_MODEL=gpt-realtime-whisper
STT_REALTIME_LANGUAGE=
STT_REALTIME_DELAY=low
TTS_ENABLED=true
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=mp3
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8787
NEXT_PUBLIC_VAD_SPEECH_THRESHOLD=0.02
NEXT_PUBLIC_VAD_SILENCE_THRESHOLD=0.012
NEXT_PUBLIC_VAD_START_DEBOUNCE_MS=160
NEXT_PUBLIC_VAD_HANGOVER_MS=750
NEXT_PUBLIC_VAD_MAX_TURN_MS=30000
NEXT_PUBLIC_VAD_PRE_ROLL_MS=400
NEXT_PUBLIC_VAD_PLAYBACK_THRESHOLD_MULTIPLIER=2.5
NEXT_PUBLIC_VAD_PLAYBACK_SUPPRESS_AFTER_END_MS=300
