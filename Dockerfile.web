FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/gateway/package.json apps/gateway/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/adapters/package.json packages/adapters/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY packages/protocol packages/protocol

ARG NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8787
ARG NEXT_PUBLIC_VAD_SPEECH_THRESHOLD=0.02
ARG NEXT_PUBLIC_VAD_SILENCE_THRESHOLD=0.012
ARG NEXT_PUBLIC_VAD_START_DEBOUNCE_MS=160
ARG NEXT_PUBLIC_VAD_HANGOVER_MS=750
ARG NEXT_PUBLIC_VAD_MAX_TURN_MS=30000
ARG NEXT_PUBLIC_VAD_PRE_ROLL_MS=400
ARG NEXT_PUBLIC_VAD_PLAYBACK_THRESHOLD_MULTIPLIER=2.5
ARG NEXT_PUBLIC_VAD_PLAYBACK_SUPPRESS_AFTER_END_MS=300
ENV NEXT_PUBLIC_GATEWAY_WS_URL=$NEXT_PUBLIC_GATEWAY_WS_URL \
    NEXT_PUBLIC_VAD_SPEECH_THRESHOLD=$NEXT_PUBLIC_VAD_SPEECH_THRESHOLD \
    NEXT_PUBLIC_VAD_SILENCE_THRESHOLD=$NEXT_PUBLIC_VAD_SILENCE_THRESHOLD \
    NEXT_PUBLIC_VAD_START_DEBOUNCE_MS=$NEXT_PUBLIC_VAD_START_DEBOUNCE_MS \
    NEXT_PUBLIC_VAD_HANGOVER_MS=$NEXT_PUBLIC_VAD_HANGOVER_MS \
    NEXT_PUBLIC_VAD_MAX_TURN_MS=$NEXT_PUBLIC_VAD_MAX_TURN_MS \
    NEXT_PUBLIC_VAD_PRE_ROLL_MS=$NEXT_PUBLIC_VAD_PRE_ROLL_MS \
    NEXT_PUBLIC_VAD_PLAYBACK_THRESHOLD_MULTIPLIER=$NEXT_PUBLIC_VAD_PLAYBACK_THRESHOLD_MULTIPLIER \
    NEXT_PUBLIC_VAD_PLAYBACK_SUPPRESS_AFTER_END_MS=$NEXT_PUBLIC_VAD_PLAYBACK_SUPPRESS_AFTER_END_MS
RUN pnpm --filter @open-gpt-live/web build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
